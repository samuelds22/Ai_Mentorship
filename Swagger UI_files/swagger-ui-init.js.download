              "bearer": []
            }
          ],
          "summary": "Complete a quest",
          "tags": [
            "Quests"
          ]
        }
      },
      "/quests/{id}/decline": {
        "patch": {
          "description": "Submits a request to decline an active IN_PROGRESS quest with an explanation reason. Only the assigned user can decline.",
          "operationId": "QuestsController_requestDecline",
          "parameters": [
            {
              "name": "id",
              "required": true,
              "in": "path",
              "description": "Quest ID",
              "schema": {
                "example": 1,
                "type": "number"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeclineQuestDto"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Quest decline request submitted successfully (status changed to DECLINE_REQUESTED)"
            },
            "400": {
              "description": "Quest cannot be declined because status is not IN_PROGRESS or invalid payload"
            },
            "401": {
              "description": "Unauthorized - Missing or invalid JWT token"
            },
            "403": {
              "description": "Forbidden - Only the assigned user can decline this quest"
            },
            "404": {
              "description": "Quest with the specified ID not found"
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Request to decline a quest",
          "tags": [
            "Quests"
          ]
        }
      },
      "/quests/{id}/decline/accept": {
        "patch": {
          "description": "Approves a pending decline request, unassigns the user, and resets quest status back to OPEN. Only ADMIN users can accept declines.",
          "operationId": "QuestsController_acceptDecline",
          "parameters": [
            {
              "name": "id",
              "required": true,
              "in": "path",
              "description": "Quest ID",
              "schema": {
                "example": 1,
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Quest decline request accepted (quest reset to OPEN status)"
            },
            "400": {
              "description": "This quest does not have a pending decline request"
            },
            "401": {
              "description": "Unauthorized - Missing or invalid JWT token"
            },
            "403": {
              "description": "Forbidden - Requires ADMIN role"
            },
            "404": {
              "description": "Quest with the specified ID not found"
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Accept a quest decline request",
          "tags": [
            "Quests"
          ]
        }
      },
      "/quests/{id}/decline/reject": {
        "patch": {
          "description": "Rejects a pending decline request, provides admin reason feedback, and returns quest status back to IN_PROGRESS. Only ADMIN users can reject declines.",
          "operationId": "QuestsController_rejectDecline",
          "parameters": [
            {
              "name": "id",
              "required": true,
              "in": "path",
              "description": "Quest ID",
              "schema": {
                "example": 1,
                "type": "number"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeclineQuestDto"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Quest decline request rejected (quest returned to IN_PROGRESS status with admin reason feedback)"
            },
            "400": {
              "description": "This quest does not have a pending decline request or missing reason payload"
            },
            "401": {
              "description": "Unauthorized - Missing or invalid JWT token"
            },
            "403": {
              "description": "Forbidden - Requires ADMIN role"
            },
            "404": {
              "description": "Quest with the specified ID not found"
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Reject a quest decline request",
          "tags": [
            "Quests"
          ]
        }
      },
