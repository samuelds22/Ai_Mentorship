    "info": {
      "title": "QuestBoard API",
      "description": "QuestBoard backend API documentation",
      "version": "1.0",
      "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
      "securitySchemes": {
        "JWT-auth": {
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "type": "http",
          "name": "JWT",
          "description": "Enter JWT token",
          "in": "header"
        },
        "bearer": {
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "type": "http"
        }
      },
      "schemas": {
        "RegisterDto": {
          "type": "object",
          "properties": {}
        },
        "LoginDto": {
          "type": "object",
          "properties": {}
        },
        "ForgotPasswordDto": {
          "type": "object",
          "properties": {}
        },
        "VerifyEmailDto": {
          "type": "object",
          "properties": {}
        },
        "ResetPasswordDto": {
          "type": "object",
          "properties": {}
        },
        "RequestReactivationDto": {
          "type": "object",
          "properties": {}
        },
        "UpdateUserDto": {
          "type": "object",
          "properties": {}
        },
        "UpdateRoleDto": {
          "type": "object",
          "properties": {}
        },
        "CreateQuestDto": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title of the quest",
              "example": "Build User Profile Dashboard",
              "minLength": 2,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "description": "Detailed description of the quest",
              "example": "Create avatar upload and user profile statistics",
              "maxLength": 500
            },
            "type": {
              "type": "string",
              "description": "Type of quest",
              "enum": [
                "FEATURE",
                "BUG",
                "LEARNING",
                "CODE_REVIEW",
                "TESTING",
                "REFACTOR",
                "DOCUMENTATION",
                "RESEARCH"
              ],
              "example": "FEATURE"
            },
            "difficulty": {
              "type": "string",
              "description": "Difficulty level of the quest",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ],
              "example": "MEDIUM"
            },
            "points": {
              "type": "number",
              "description": "Reward points earned upon completion",
              "example": 50,
              "minimum": 0
            },
            "teamId": {
              "type": "number",
              "description": "Optional Team ID to associate the quest with",
              "example": 1,
              "minimum": 1
            },
            "dueDate": {
              "type": "string",
              "description": "Due date in ISO 8601 string format",
              "example": "2026-09-15T18:00:00.000Z"
            }
          },
          "required": [
            "title",
            "type",
            "difficulty",
            "points"
          ]
        },
        "UpdateQuestDto": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title of the quest",
              "example": "Build User Profile Dashboard",
              "minLength": 2,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "description": "Detailed description of the quest",
              "example": "Create avatar upload and user profile statistics",
              "maxLength": 500
            },
            "type": {
              "type": "string",
              "description": "Type of quest",
              "enum": [
                "FEATURE",
                "BUG",
                "LEARNING",
                "CODE_REVIEW",
                "TESTING",
                "REFACTOR",
                "DOCUMENTATION",
                "RESEARCH"
              ],
              "example": "FEATURE"
            },
            "difficulty": {
              "type": "string",
              "description": "Difficulty level of the quest",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ],
              "example": "MEDIUM"
            },
            "points": {
              "type": "number",
              "description": "Reward points earned upon completion",
              "example": 50,
              "minimum": 0
            },
            "teamId": {
              "type": "number",
              "description": "Team ID to associate or reassign",
              "example": 1,
              "minimum": 1
            },
            "dueDate": {
              "type": "string",
              "description": "Due date in ISO 8601 string format",
              "example": "2026-09-15T18:00:00.000Z"
            },
            "status": {
              "type": "string",
              "description": "New status for the quest",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "DECLINE_REQUESTED",
                "COMPLETED",
                "CANCELLED"
              ],
              "example": "IN_PROGRESS"
            }
          }
        },
        "AssignQuestDto": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "number",
              "description": "User ID to assign the quest to (mutually exclusive with teamId; quest must have a team first)",
              "example": 2,
              "minimum": 1
            },
            "teamId": {
              "type": "number",
              "description": "Team ID to assign the quest to (mutually exclusive with userId)",
              "example": 1,
              "minimum": 1
            }
          }
        },
        "DeclineQuestDto": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "description": "Reason for requesting quest decline or admin reason for rejecting decline",
              "example": "I am currently allocated to critical sprint bugfixes.",
              "minLength": 5,
              "maxLength": 500
            }
          },
          "required": [
            "reason"
          ]
        },
        "CreateTeamDto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "example": "Development Team",
              "description": "Name of the team"
            },
            "description": {
              "type": "string",
              "example": "Team responsible for backend development",
              "description": "Description of the team"
            }
          },
          "required": [
            "name"
          ]
        },
        "UpdateTeamDto": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ],
              "example": "ACTIVE",
              "description": "Status of the team"
            }
          }
        },
        "AddMemberDto": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "number",
              "example": 2,
              "description": "ID of the user to add to the team"
            },
            "role": {
              "type": "string",
              "enum": [
                "LEADER",
                "MEMBER"
              ],
              "example": "MEMBER",
              "description": "Role of the team member"
            }
          },
          "required": [
            "userId"
          ]
        },
        "UpdateMemberRoleDto": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "LEADER",
                "MEMBER"
              ],
              "example": "MEMBER",
              "description": "Role of the team member"
            },
            "status": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ],
              "example": "ACTIVE",
              "description": "Status of the team member"
            }
          }
        },
        "CreateCommentDto": {
          "type": "object",
          "properties": {}
        },
        "UpdateCommentDto": {
          "type": "object",
          "properties": {}
        }
      }
    }
  },
  "customOptions": {}
};
  url = options.swaggerUrl || url
  let urls = options.swaggerUrls
  let customOptions = options.customOptions
  let spec1 = options.swaggerDoc
  let swaggerOptions = {
    spec: spec1,
    url: url,
    urls: urls,
    dom_id: '#swagger-ui',
    deepLinking: true,
    presets: [
      SwaggerUIBundle.presets.apis,
      SwaggerUIStandalonePreset
    ],
    plugins: [
      SwaggerUIBundle.plugins.DownloadUrl
    ],
    layout: "StandaloneLayout"
  }
  for (let attrname in customOptions) {
    swaggerOptions[attrname] = customOptions[attrname];
  }
  let ui = SwaggerUIBundle(swaggerOptions)

  if (customOptions.initOAuth) {
    ui.initOAuth(customOptions.initOAuth)
  }

  if (customOptions.authAction) {
    ui.authActions.authorize(customOptions.authAction)
  }
  
  window.ui = ui
}
